{$SITE_ADDRESS} {
	encode gzip
	handle_path /api/* {
		reverse_proxy spring:8080
	}
	# 사진과 그림: Spring 로그인 세션(GET /me)이 확인돼야 넘긴다
	handle /fa/files/* {
		forward_auth spring:8080 {
			uri /me
		}
		uri strip_prefix /fa
		reverse_proxy fastapi:8000
	}
	# 생성 API, 실험 도구, 오류 주입 같은 나머지 FastAPI 경로는 밖에 열지 않는다
	handle /fa/* {
		respond 404
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
